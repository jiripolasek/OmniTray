<Window
    x:Class="OmniTray.Views.StackOrganizerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniTray.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:organizer="using:OmniTray.Views.Organizer"
    xmlns:organizerViewModels="using:OmniTray.ViewModels.Organizer"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:OmniTray.ViewModels"
    Title="OmniTray Stack organizer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="N"
                Invoked="OnNewNoteAcceleratorInvoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="F"
                Invoked="OnSearchAcceleratorInvoked"
                Modifiers="Control" />
            <KeyboardAccelerator Key="F6" Invoked="OnSwitchNotePreviewInvoked" />
            <KeyboardAccelerator
                Key="S"
                Invoked="OnSaveNoteInvoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <organizer:OrganizerTemplates />
                </ResourceDictionary.MergedDictionaries>
                <DataTemplate x:Key="OrganizerScopeItemTemplate" x:DataType="viewModels:StackOrganizerScopeViewModel">
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:Key="SearchPopupEmptyTemplate">
                    <TextBlock
                        Margin="12,12"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="14"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                </DataTemplate>
                <DataTemplate x:Key="SearchPopupFooterTemplate">
                    <Grid Visibility="Collapsed">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <Button
                                MinHeight="40"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AllowFocusOnInteraction="False"
                                Click="OnShowAllSearchResultsClick"
                                Content="Show all results"
                                IsTabStop="False"
                                Style="{StaticResource SubtleButtonStyle}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Stack organizer"
            AutoRefreshDragRegions="True"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            SizeChanged="OnOrganizerTitleBarSizeChanged">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="GlobalSearchBox"
                    Width="420"
                    MinWidth="140"
                    MaxWidth="480"
                    x:DataType="organizerViewModels:StackSearchResultViewModel"
                    AutomationProperties.Name="Search all stacks and items"
                    ItemTemplate="{StaticResource SearchSuggestionTemplate}"
                    PlaceholderText="Search stacks and items"
                    QueryIcon="Find"
                    QuerySubmitted="OnGlobalSearchQuerySubmitted"
                    TextChanged="OnGlobalSearchTextChanged"
                    TextMemberPath="Title"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </AutoSuggestBox.ItemContainerStyle>
                    <AutoSuggestBox.GroupStyle>
                        <GroupStyle
                            HeaderContainerStyle="{StaticResource CompactSearchGroupHeaderStyle}"
                            HeaderTemplate="{StaticResource SearchGroupHeaderTemplate}"
                            HidesIfEmpty="True" />
                    </AutoSuggestBox.GroupStyle>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="OrganizerNavigation"
            Grid.Row="1"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="880"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            ItemInvoked="OnNavigationItemInvoked"
            OpenPaneLength="240"
            PaneDisplayMode="Auto"
            SelectionChanged="OnScopeSelectionChanged">
            <NavigationView.MenuItems>
                <!--  Keep the label template off NavigationViewItem: its native icon presenter inherits ContentTemplate.  -->
                <NavigationViewItem
                    x:Name="AllStacksNavigationItem"
                    AutomationProperties.Name="{x:Bind ViewModel.AllStacksScope.DisplayName}"
                    Tag="{x:Bind ViewModel.AllStacksScope}">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                    <ContentPresenter Content="{x:Bind ViewModel.AllStacksScope}" ContentTemplate="{StaticResource OrganizerScopeItemTemplate}" />
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NotesNavigationItem"
                    AutomationProperties.Name="Browse notes"
                    Content="Notes"
                    Tag="notes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Edge windows" />
                <NavigationViewItem
                    AllowDrop="True"
                    AutomationProperties.HelpText="Drop a stack here to move it to the left edge."
                    AutomationProperties.Name="{x:Bind ViewModel.LeftEdgeScope.DisplayName}"
                    DragEnter="OnEdgeNavigationDragOver"
                    DragOver="OnEdgeNavigationDragOver"
                    Drop="OnEdgeNavigationDrop"
                    Tag="{x:Bind ViewModel.LeftEdgeScope}">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Glyph="&#xE90C;" />
                    </NavigationViewItem.Icon>
                    <ContentPresenter Content="{x:Bind ViewModel.LeftEdgeScope}" ContentTemplate="{StaticResource OrganizerScopeItemTemplate}" />
                </NavigationViewItem>
                <NavigationViewItem
                    AllowDrop="True"
                    AutomationProperties.HelpText="Drop a stack here to move it to the right edge."
                    AutomationProperties.Name="{x:Bind ViewModel.RightEdgeScope.DisplayName}"
                    DragEnter="OnEdgeNavigationDragOver"
                    DragOver="OnEdgeNavigationDragOver"
                    Drop="OnEdgeNavigationDrop"
                    Tag="{x:Bind ViewModel.RightEdgeScope}">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Glyph="&#xE90D;" />
                    </NavigationViewItem.Icon>
                    <ContentPresenter Content="{x:Bind ViewModel.RightEdgeScope}" ContentTemplate="{StaticResource OrganizerScopeItemTemplate}" />
                </NavigationViewItem>
                <NavigationViewItem
                    AllowDrop="True"
                    AutomationProperties.HelpText="Drop a stack here to move it to the top edge."
                    AutomationProperties.Name="{x:Bind ViewModel.TopEdgeScope.DisplayName}"
                    DragEnter="OnEdgeNavigationDragOver"
                    DragOver="OnEdgeNavigationDragOver"
                    Drop="OnEdgeNavigationDrop"
                    Tag="{x:Bind ViewModel.TopEdgeScope}">
                    <NavigationViewItem.Icon>
                        <!--  Dock top uses the native DockBottom glyph rotated around its center.  -->
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Glyph="&#xE90E;"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="180" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                    <ContentPresenter Content="{x:Bind ViewModel.TopEdgeScope}" ContentTemplate="{StaticResource OrganizerScopeItemTemplate}" />
                </NavigationViewItem>
                <NavigationViewItem
                    AllowDrop="True"
                    AutomationProperties.HelpText="Drop a stack here to move it to the bottom edge."
                    AutomationProperties.Name="{x:Bind ViewModel.BottomEdgeScope.DisplayName}"
                    DragEnter="OnEdgeNavigationDragOver"
                    DragOver="OnEdgeNavigationDragOver"
                    Drop="OnEdgeNavigationDrop"
                    Tag="{x:Bind ViewModel.BottomEdgeScope}">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Glyph="&#xE90E;" />
                    </NavigationViewItem.Icon>
                    <ContentPresenter Content="{x:Bind ViewModel.BottomEdgeScope}" ContentTemplate="{StaticResource OrganizerScopeItemTemplate}" />
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    AllowDrop="True"
                    AutomationProperties.HelpText="Create an empty stack, or drop items here to create a stack in the selected location."
                    Content="New stack"
                    DragEnter="OnNewStackNavigationDragOver"
                    DragOver="OnNewStackNavigationDragOver"
                    Drop="OnNewStackNavigationDrop"
                    SelectsOnInvoked="False"
                    Tag="new-stack">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Add" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AllowDrop="True"
                    AutomationProperties.HelpText="Create a stack from the clipboard, or drop items here to create a stack in the selected location."
                    Content="New stack from clipboard"
                    DragEnter="OnNewStackNavigationDragOver"
                    DragOver="OnNewStackNavigationDragOver"
                    Drop="OnNewStackNavigationDrop"
                    SelectsOnInvoked="False"
                    Tag="new-stack-from-clipboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Paste" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Settings"
                    SelectsOnInvoked="False"
                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="BrowserContent" SizeChanged="OnBrowserContentSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition
                            x:Name="DetailsColumn"
                            Width="288"
                            MinWidth="240" />
                    </Grid.ColumnDefinitions>
                    <ContentControl
                        x:Name="PageHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False" />
                    <toolkit:GridSplitter
                        x:Name="DetailsSplitter"
                        Grid.Column="1"
                        Width="8"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Resize Preview pane"
                        KeyboardIncrement="16"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Columns"
                        ToolTipService.ToolTip="Resize Preview pane (Left/Right arrow keys when focused)" />
                    <controls:OrganizerDetailsPane x:Name="DetailsPane" Grid.Column="2" />
                </Grid>
                <ContentControl
                    x:Name="SearchHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Visibility="Collapsed" />
                <InfoBar
                    x:Name="NoteSaveErrorBar"
                    Title="Could not save note changes"
                    Grid.Row="1"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error">
                    <InfoBar.ActionButton>
                        <Button Click="OnRetryNoteSaveClick" Content="Retry" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </NavigationView>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="CompactWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsSplitter.Visibility" Value="Collapsed" />
                        <Setter Target="DetailsColumn.Width" Value="0" />
                        <Setter Target="DetailsColumn.MinWidth" Value="0" />
                        <Setter Target="DetailsPane.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RegularWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsSplitter.Visibility" Value="Collapsed" />
                        <Setter Target="DetailsColumn.Width" Value="0" />
                        <Setter Target="DetailsColumn.MinWidth" Value="0" />
                        <Setter Target="DetailsPane.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1080" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsSplitter.Visibility" Value="Visible" />
                        <Setter Target="DetailsPane.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
