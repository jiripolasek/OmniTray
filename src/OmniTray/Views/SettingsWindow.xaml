<Window
    x:Class="OmniTray.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:OmniTray.ViewModels"
    Title="OmniTray Settings"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <x:Double x:Key="SettingActionControlMinWidth">180</x:Double>
        </Grid.Resources>

        <TitleBar
            x:Name="AppTitleBar"
            Title="OmniTray Settings"
            AutoRefreshDragRegions="True"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False" />

        <NavigationView
            x:Name="SettingsNavigation"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="880"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            Loaded="OnLoaded"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="GeneralNavigationItem"
                    Content="General"
                    Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Stacks &amp; trays" Tag="trays">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Commands" Tag="commands">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <ScrollViewer
                    x:Name="GeneralSection"
                    HorizontalContentAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="900"
                        Padding="32,24,32,36"
                        HorizontalAlignment="Stretch"
                        Spacing="24">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="General" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Choose how the resident app starts, appears, and behaves."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Resident behavior" />

                            <toolkit:SettingsCard Header="Start with Windows">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7E8;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <toolkit:SettingsCard.Description>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            x:Name="StartWithWindowsDescription"
                                            Text="Checking Windows startup registration…"
                                            TextWrapping="Wrap" />
                                        <HyperlinkButton
                                            x:Name="StartupAppsSettingsLink"
                                            Padding="0"
                                            Click="OnOpenStartupAppsSettingsClick"
                                            Content="Open Windows Startup Apps"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Description>
                                <ToggleSwitch
                                    x:Name="StartWithWindowsToggle"
                                    AutomationProperties.Name="Start OmniTray with Windows"
                                    IsEnabled="False"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="OnStartWithWindowsToggled" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard
                                Description="Hide every edge hint and panel until you turn this off. This choice persists across restarts."
                                Header="Pause edge windows">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE769;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <ToggleSwitch
                                    AutomationProperties.Name="Pause edge windows"
                                    IsOn="{x:Bind ViewModel.EdgeWindowsPaused, Mode=TwoWay}"
                                    OffContent="Running"
                                    OnContent="Paused" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard
                                Description="Hide edge windows while Windows reports fullscreen Direct3D, presentation, or busy activity."
                                Header="Game mode">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7FC;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <ToggleSwitch
                                    AutomationProperties.Name="Suppress edge windows during games and fullscreen activity"
                                    IsOn="{x:Bind ViewModel.GameModeEnabled, Mode=TwoWay}"
                                    OffContent="Off"
                                    OnContent="On" />
                            </toolkit:SettingsCard>

                            <InfoBar
                                Title="Game mode is hiding edge windows"
                                IsClosable="False"
                                IsOpen="{x:Bind ViewModel.IsGameModeSuppressing, Mode=OneWay}"
                                Message="{x:Bind ViewModel.GameModeStatusText, Mode=OneWay}"
                                Severity="Informational" />

                            <toolkit:SettingsCard Header="Toast position">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE75A;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <toolkit:SettingsCard.Description>
                                    <HyperlinkButton
                                        x:Name="ToastSystemSettingsLink"
                                        Padding="0"
                                        Click="OnOpenSystemNotificationSettingsClick"
                                        Content="Open Windows notification settings" />
                                </toolkit:SettingsCard.Description>
                                <ComboBox
                                    x:Name="ToastPositionBox"
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    AutomationProperties.Name="Toast position"
                                    SelectionChanged="OnToastPositionSelectionChanged">
                                    <ComboBoxItem Content="Use system settings" />
                                    <ComboBoxItem Content="Bottom center" />
                                    <ComboBoxItem Content="Top left" />
                                    <ComboBoxItem Content="Top center" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Diagnostics" />

                            <toolkit:SettingsCard
                                Description="See every standard and custom format advertised by a drop or the clipboard."
                                Header="Data format inspector">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE9D9;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button
                                    AutomationProperties.Name="Open data format inspector"
                                    Click="OnOpenDataFormatInspectorClick"
                                    Content="Open inspector" />
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="About" />

                            <toolkit:SettingsExpander Description="© Jiří Polášek 2024–2026" Header="OmniTray">
                                <toolkit:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="&#xE946;" />
                                </toolkit:SettingsExpander.HeaderIcon>
                                <TextBlock Text="{x:Bind VersionText}" />
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard Header="Website">
                                        <HyperlinkButton Content="jiripolasek.com"
                                                         NavigateUri="https://jiripolasek.com" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="Source code">
                                        <HyperlinkButton Content="github.com/jiripolasek/omnitray"
                                                         NavigateUri="https://github.com/jiripolasek/omnitray" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="Copyright">
                                        <TextBlock Text="© Jiří Polášek 2024–2026" />
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="TraysSection"
                    HorizontalContentAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="900"
                        Padding="32,24,32,36"
                        HorizontalAlignment="Stretch"
                        Spacing="24">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Stacks &amp; trays" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Configure stack interaction, appearance, drag-out behavior, and which edge trays stay active."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Interaction" />
                            <toolkit:SettingsCard
                                Description="Pause over a stack preview or minimal tray icon to open its inspector."
                                Header="Open inspector on hover">
                                <ToggleSwitch
                                    x:Name="OpenInspectorOnHoverToggle"
                                    AutomationProperties.Name="Open tray inspector on hover"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="OnOpenInspectorOnHoverToggled" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Description="Collapse an expanded tray after it stays unfocused for the selected time."
                                Header="Auto-collapse expanded trays">
                                <ComboBox
                                    x:Name="TrayAutoCollapseDelayBox"
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    AutomationProperties.Name="Auto-collapse delay for expanded trays"
                                    SelectionChanged="OnTrayAutoCollapseDelaySelectionChanged">
                                    <ComboBoxItem Content="Off" />
                                    <ComboBoxItem Content="1 second" />
                                    <ComboBoxItem Content="2 seconds" />
                                    <ComboBoxItem Content="3 seconds" />
                                    <ComboBoxItem Content="5 seconds" />
                                    <ComboBoxItem Content="10 seconds" />
                                    <ComboBoxItem Content="20 seconds" />
                                    <ComboBoxItem Content="30 seconds" />
                                    <ComboBoxItem Content="60 seconds" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Appearance" />
                            <toolkit:SettingsCard
                                Description="Show every tray set to Neutral using the Windows accent color."
                                Header="Use Windows accent for neutral trays">
                                <ToggleSwitch
                                    x:Name="UseSystemAccentForNeutralToggle"
                                    AutomationProperties.Name="Use Windows accent for neutral trays"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="OnUseSystemAccentForNeutralToggled" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Description="Used in the main popup and on the left and right edge shelves."
                                Header="Vertical stack cards">
                                <ComboBox
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    AutomationProperties.Name="Vertical stack card style"
                                    SelectedIndex="{x:Bind ViewModel.VerticalStackCardDisplayModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Small list" />
                                    <ComboBoxItem Content="Large list" />
                                    <ComboBoxItem Content="Thumbnail icons" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Description="Used on the top and bottom edge shelves."
                                                  Header="Horizontal stack cards">
                                <ComboBox
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    AutomationProperties.Name="Horizontal stack card style"
                                    SelectedIndex="{x:Bind ViewModel.HorizontalStackCardDisplayModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Small list" />
                                    <ComboBoxItem Content="Large list" />
                                    <ComboBoxItem Content="Thumbnail icons" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Drag behavior" />
                            <toolkit:SettingsCard
                                Description="While dragging files, text, images, or stack items, quickly shake the mouse to open a new tray under the pointer, then release to drop."
                                Header="Shake to create a tray">
                                <ToggleSwitch
                                    x:Name="ShakeToCreateTrayToggle"
                                    AutomationProperties.Name="Shake the mouse while dragging to create a tray"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="OnShakeToCreateTrayToggled" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Description="Regular drags copy. When enabled, hold Shift as you start dragging original files to allow a move."
                                Header="Allow Shift-drag to move original files">
                                <ToggleSwitch
                                    x:Name="AllowMoveOnDragOutToggle"
                                    AutomationProperties.Name="Allow Shift-drag to move original files"
                                    OffContent="Copy only"
                                    OnContent="Shift enables move"
                                    Toggled="OnAllowMoveOnDragOutToggled" />
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Edge trays" />

                            <toolkit:SettingsExpander
                                Description="Enable and arrange each edge tray independently. Settings apply on every connected display."
                                Header="Edge tray layout">
                                <TextBlock Text="Per display" />
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard Description="Configure the tray attached to the left edge."
                                                          Header="Left edge">
                                        <StackPanel MinWidth="{StaticResource SettingActionControlMinWidth}"
                                                    Spacing="8">
                                            <ToggleSwitch
                                                AutomationProperties.Name="Enable left edge window"
                                                IsOn="{x:Bind ViewModel.LeftEdgeWindowEnabled, Mode=TwoWay}"
                                                OffContent="Off"
                                                OnContent="On" />
                                            <ComboBox
                                                AutomationProperties.Name="Left edge window size"
                                                Header="Size"
                                                SelectedIndex="{x:Bind ViewModel.LeftEdgeWindowSizeModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Reasonable" />
                                                <ComboBoxItem Content="Stretch along edge" />
                                            </ComboBox>
                                            <ComboBox
                                                AutomationProperties.Name="Left edge window position"
                                                Header="Position"
                                                IsEnabled="{x:Bind ViewModel.CanPositionLeftEdgeWindow, Mode=OneWay}"
                                                SelectedIndex="{x:Bind ViewModel.LeftEdgeWindowAlignmentIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Top" />
                                                <ComboBoxItem Content="Center" />
                                                <ComboBoxItem Content="Bottom" />
                                            </ComboBox>
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Description="Configure the tray attached to the right edge."
                                                          Header="Right edge">
                                        <StackPanel MinWidth="{StaticResource SettingActionControlMinWidth}"
                                                    Spacing="8">
                                            <ToggleSwitch
                                                AutomationProperties.Name="Enable right edge window"
                                                IsOn="{x:Bind ViewModel.RightEdgeWindowEnabled, Mode=TwoWay}"
                                                OffContent="Off"
                                                OnContent="On" />
                                            <ComboBox
                                                AutomationProperties.Name="Right edge window size"
                                                Header="Size"
                                                SelectedIndex="{x:Bind ViewModel.RightEdgeWindowSizeModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Reasonable" />
                                                <ComboBoxItem Content="Stretch along edge" />
                                            </ComboBox>
                                            <ComboBox
                                                AutomationProperties.Name="Right edge window position"
                                                Header="Position"
                                                IsEnabled="{x:Bind ViewModel.CanPositionRightEdgeWindow, Mode=OneWay}"
                                                SelectedIndex="{x:Bind ViewModel.RightEdgeWindowAlignmentIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Top" />
                                                <ComboBoxItem Content="Center" />
                                                <ComboBoxItem Content="Bottom" />
                                            </ComboBox>
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Description="Configure the tray attached to the top edge."
                                                          Header="Top edge">
                                        <StackPanel MinWidth="{StaticResource SettingActionControlMinWidth}"
                                                    Spacing="8">
                                            <ToggleSwitch
                                                AutomationProperties.Name="Enable top edge window"
                                                IsOn="{x:Bind ViewModel.TopEdgeWindowEnabled, Mode=TwoWay}"
                                                OffContent="Off"
                                                OnContent="On" />
                                            <ComboBox
                                                AutomationProperties.Name="Top edge window size"
                                                Header="Size"
                                                SelectedIndex="{x:Bind ViewModel.TopEdgeWindowSizeModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Reasonable" />
                                                <ComboBoxItem Content="Stretch along edge" />
                                            </ComboBox>
                                            <ComboBox
                                                AutomationProperties.Name="Top edge window position"
                                                Header="Position"
                                                IsEnabled="{x:Bind ViewModel.CanPositionTopEdgeWindow, Mode=OneWay}"
                                                SelectedIndex="{x:Bind ViewModel.TopEdgeWindowAlignmentIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Left" />
                                                <ComboBoxItem Content="Center" />
                                                <ComboBoxItem Content="Right" />
                                            </ComboBox>
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Description="Configure the tray attached to the bottom edge."
                                                          Header="Bottom edge">
                                        <StackPanel MinWidth="{StaticResource SettingActionControlMinWidth}"
                                                    Spacing="8">
                                            <ToggleSwitch
                                                AutomationProperties.Name="Enable bottom edge window"
                                                IsOn="{x:Bind ViewModel.BottomEdgeWindowEnabled, Mode=TwoWay}"
                                                OffContent="Off"
                                                OnContent="On" />
                                            <ComboBox
                                                AutomationProperties.Name="Bottom edge window size"
                                                Header="Size"
                                                SelectedIndex="{x:Bind ViewModel.BottomEdgeWindowSizeModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Reasonable" />
                                                <ComboBoxItem Content="Stretch along edge" />
                                            </ComboBox>
                                            <ComboBox
                                                AutomationProperties.Name="Bottom edge window position"
                                                Header="Position"
                                                IsEnabled="{x:Bind ViewModel.CanPositionBottomEdgeWindow, Mode=OneWay}"
                                                SelectedIndex="{x:Bind ViewModel.BottomEdgeWindowAlignmentIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Left" />
                                                <ComboBoxItem Content="Center" />
                                                <ComboBoxItem Content="Right" />
                                            </ComboBox>
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>

                            <toolkit:SettingsExpander
                                Description="Shared windows use one ordered tray. Enabling a switch merges content into its named destination; turning it off does not redistribute stacks."
                                Header="Synchronize edge tray content">
                                <TextBlock Text="Optional" />
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard
                                        Description="Show one tray on both sides. Enabling appends Right content to Left."
                                        Header="Left and right">
                                        <ToggleSwitch
                                            AutomationProperties.Name="Synchronize left and right edge tray content"
                                            IsEnabled="{x:Bind ViewModel.CanConfigurePairedEdgeContentSync, Mode=OneWay}"
                                            IsOn="{x:Bind ViewModel.SyncLeftAndRightEdgeContent, Mode=TwoWay}"
                                            OffContent="Separate"
                                            OnContent="Shared" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Description="Show one tray on both edges. Enabling appends Bottom content to Top."
                                        Header="Top and bottom">
                                        <ToggleSwitch
                                            AutomationProperties.Name="Synchronize top and bottom edge tray content"
                                            IsEnabled="{x:Bind ViewModel.CanConfigurePairedEdgeContentSync, Mode=OneWay}"
                                            IsOn="{x:Bind ViewModel.SyncTopAndBottomEdgeContent, Mode=TwoWay}"
                                            OffContent="Separate"
                                            OnContent="Shared" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Description="Show one tray on every edge. Enabling appends Right, Top, and Bottom content to Left."
                                        Header="All edge trays">
                                        <ToggleSwitch
                                            AutomationProperties.Name="Synchronize all edge tray content"
                                            IsOn="{x:Bind ViewModel.SyncAllEdgeContent, Mode=TwoWay}"
                                            OffContent="Separate"
                                            OnContent="Shared" />
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="CommandsSection"
                    HorizontalContentAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="900"
                        Padding="32,24,32,36"
                        HorizontalAlignment="Stretch"
                        Spacing="24">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Commands" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Configure an action once, then choose and organize where it appears. Each edge and the popup have their own layout."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar
                            x:Name="CommandStatusBar"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Informational" />

                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Text="Configured commands" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Parameters and accepted content are shared everywhere the command appears."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Add drop command"
                                    Content="Add command">
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="AddCommandTemplateFlyout" />
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <Border
                                x:Name="NoCommandsNotice"
                                Padding="18"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{x:Bind CollapsedWhen(ViewModel.HasCommands), Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No commands configured yet. Add a command template to get started."
                                    TextWrapping="Wrap" />
                            </Border>

                            <ListView
                                x:Name="CommandDefinitionsList"
                                AutomationProperties.Name="Configured drop commands"
                                ItemsSource="{x:Bind ViewModel.CommandDefinitions, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind VisibleWhen(ViewModel.HasCommands), Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DropCommandViewModel">
                                        <Grid Padding="12,9" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="40"
                                                Height="40"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="7">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                           Text="{x:Bind Name, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Summary, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind AcceptanceText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <Button
                                                    AutomationProperties.Name="Edit command"
                                                    Click="OnEditCommandClick"
                                                    ToolTipService.ToolTip="Edit">
                                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Pop out command"
                                                    Click="OnPopOutCommandClick"
                                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Pop out">
                                                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Delete command"
                                                    Click="OnDeleteCommandClick"
                                                    ToolTipService.ToolTip="Delete">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Surface layout" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Order commands and group them into folders for one logical surface."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="CommandSurfaceBox"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    AutomationProperties.Name="Command surface"
                                    SelectionChanged="OnCommandSurfaceSelectionChanged">
                                    <ComboBoxItem Content="Popup" Tag="popup" />
                                    <ComboBoxItem Content="Left edge" Tag="edge:left" />
                                    <ComboBoxItem Content="Right edge" Tag="edge:right" />
                                    <ComboBoxItem Content="Top edge" Tag="edge:top" />
                                    <ComboBoxItem Content="Bottom edge" Tag="edge:bottom" />
                                </ComboBox>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.Name="Place an existing command"
                                    Click="OnAddExistingCommandClick"
                                    Content="Add existing" />
                                <Button
                                    AutomationProperties.Name="Add command folder"
                                    Click="OnAddCommandFolderClick"
                                    Content="Add folder" />
                            </StackPanel>

                            <Border
                                x:Name="EmptyCommandLayoutNotice"
                                Padding="18"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{x:Bind VisibleWhen(ViewModel.IsCommandLayoutEmpty), Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="This surface is empty. Add an existing command or a folder."
                                    TextWrapping="Wrap" />
                            </Border>

                            <ListView
                                x:Name="CommandLayoutList"
                                AutomationProperties.Name="Drop command surface layout"
                                ItemsSource="{x:Bind ViewModel.CommandPlacementItems, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind CollapsedWhen(ViewModel.IsCommandLayoutEmpty), Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DropCommandPlacementViewModel">
                                        <Grid Padding="10,8" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="36"
                                                Height="36"
                                                Margin="{x:Bind Indent, Mode=OneWay}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="6">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                           Text="{x:Bind DisplayName, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Summary, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="2">
                                                <Button
                                                    AutomationProperties.Name="Rename folder"
                                                    Click="OnRenameCommandFolderClick"
                                                    ToolTipService.ToolTip="Rename folder"
                                                    Visibility="{x:Bind FolderVisibility, Mode=OneWay}">
                                                    <FontIcon FontSize="13" Glyph="&#xE70F;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Move item up"
                                                    Click="OnMoveCommandPlacementUpClick"
                                                    ToolTipService.ToolTip="Move up">
                                                    <FontIcon FontSize="13" Glyph="&#xE74A;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Move item down"
                                                    Click="OnMoveCommandPlacementDownClick"
                                                    ToolTipService.ToolTip="Move down">
                                                    <FontIcon FontSize="13" Glyph="&#xE74B;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Move item to folder"
                                                    Click="OnMoveCommandPlacementToFolderClick"
                                                    ToolTipService.ToolTip="Move to folder">
                                                    <FontIcon FontSize="13" Glyph="&#xE8DE;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Remove item from this surface"
                                                    Click="OnRemoveCommandPlacementClick"
                                                    ToolTipService.ToolTip="Remove from this surface">
                                                    <FontIcon FontSize="13" Glyph="&#xE711;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Removing a folder keeps its contents and moves them up one level. Hovering a folder while dragging opens it."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>