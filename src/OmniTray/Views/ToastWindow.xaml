<views:TransparentWindow
    x:Class="OmniTray.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OmniTray.Views"
    Title="OmniTray notification">
    <Grid Background="Transparent">
        <Grid
            x:Name="Surface"
            MaxWidth="560"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SurfaceTransform" />
            </Grid.RenderTransform>
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>

            <SystemBackdropElement CornerRadius="8">
                <SystemBackdropElement.SystemBackdrop>
                    <DesktopAcrylicBackdrop />
                </SystemBackdropElement.SystemBackdrop>
            </SystemBackdropElement>
            <Border
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False" />
            <TextBlock
                x:Name="MessageText"
                Margin="16,10,20,12"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                MaxLines="3"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</views:TransparentWindow>