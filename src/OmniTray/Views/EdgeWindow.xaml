<views:TransparentWindow
    x:Class="OmniTray.Views.EdgeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniTray.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:viewModels="using:OmniTray.ViewModels"
    xmlns:views="using:OmniTray.Views"
    Title="Shelf"
    mc:Ignorable="d">
    <Grid x:Name="RootSurface">
        <Grid.Resources>
            <ItemsPanelTemplate x:Key="VerticalStackPanel">
                <ItemsStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="HorizontalStackPanel">
                <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
            <Style x:Key="VerticalStackItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="HorizontalStackItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="LargeTargetButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid
            x:Name="ShelfSurface"
            AllowDrop="True"
            Background="Transparent"
            DragEnter="OnRootDragEnter"
            DragLeave="OnRootDragLeave"
            DragOver="OnRootDragOver"
            Drop="OnRootDrop"
            PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited">
            <SystemBackdropElement
                x:Name="ShelfBackdrop"
                CornerRadius="12"
                IsHitTestVisible="False">
                <SystemBackdropElement.SystemBackdrop>
                    <views:AlwaysActiveDesktopAcrylicBackdrop />
                </SystemBackdropElement.SystemBackdrop>
                <SystemBackdropElement.Shadow>
                    <ThemeShadow />
                </SystemBackdropElement.Shadow>
            </SystemBackdropElement>
            <Border
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False" />

            <Grid x:Name="ShelfContent">
                <Grid x:Name="ContentRoot">
                    <Grid x:Name="VerticalShelfLayout">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16,10,8,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Shelf" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="VerticalSearchButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.HelpText="Open a live filter for the stacks on this shelf"
                                    AutomationProperties.Name="Search stacks"
                                    Click="OnSearchClick"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Search stacks (Ctrl+F)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                                    </Button.KeyboardAccelerators>
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE721;" />
                                </Button>
                                <Button
                                    x:Name="VerticalMoreButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="Shelf options"
                                    Click="OnMoreClick"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Shelf options">
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="Hide edge shelf"
                                    Click="OnCollapseClick"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Hide">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="10,0,10,4">
                            <ListView
                                x:Name="EdgeStackList"
                                MinHeight="72"
                                AllowDrop="True"
                                AutomationProperties.HelpText="Select a stack header to organize its items. Drag stacks to reorder them."
                                AutomationProperties.Name="Stacks in this edge shelf"
                                CanDragItems="False"
                                CanReorderItems="False"
                                DragLeave="OnStackListDragLeave"
                                DragOver="OnStackListDragOver"
                                Drop="OnStackListDrop"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource VerticalStackItemStyle}"
                                ItemsPanel="{StaticResource VerticalStackPanel}"
                                ItemsSource="{x:Bind EdgeStacks, Mode=OneWay}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DropStackViewModel">
                                        <Grid
                                            x:Name="StackRoot"
                                            MinWidth="260"
                                            HorizontalAlignment="Stretch"
                                            AllowDrop="True"
                                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                            DragLeave="OnStackDragLeave"
                                            DragOver="OnStackDragOver"
                                            Drop="OnStackDrop"
                                            Tag="{x:Bind}">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="OnInspectStackClick"
                                                        Icon="View"
                                                        Tag="{x:Bind}"
                                                        Text="Inspect" />
                                                    <MenuFlyoutItem
                                                        Click="OnOpenTrayMenuClick"
                                                        Tag="{x:Bind}"
                                                        Text="Pop out as tray">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8A7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        Click="OnInsertClipboardContentMenuClick"
                                                        Icon="Paste"
                                                        Tag="{x:Bind}"
                                                        Text="Insert Clipboard content" />
                                                    <MenuFlyoutSubItem Text="Edge shelf">
                                                        <RadioMenuFlyoutItem
                                                            Click="OnRemoveFromEdgeMenuClick"
                                                            GroupName="EdgeShelf"
                                                            IsChecked="{x:Bind IsNotOnEdgeShelf, Mode=OneWay}"
                                                            Tag="{x:Bind}"
                                                            Text="None" />
                                                        <MenuFlyoutSeparator />
                                                        <RadioMenuFlyoutItem
                                                            Click="OnMoveToLeftMenuClick"
                                                            GroupName="EdgeShelf"
                                                            IsChecked="{x:Bind IsOnLeftEdgeShelf, Mode=OneWay}"
                                                            Tag="{x:Bind}"
                                                            Text="Left" />
                                                        <RadioMenuFlyoutItem
                                                            Click="OnMoveToRightMenuClick"
                                                            GroupName="EdgeShelf"
                                                            IsChecked="{x:Bind IsOnRightEdgeShelf, Mode=OneWay}"
                                                            Tag="{x:Bind}"
                                                            Text="Right" />
                                                        <RadioMenuFlyoutItem
                                                            Click="OnMoveToTopMenuClick"
                                                            GroupName="EdgeShelf"
                                                            IsChecked="{x:Bind IsOnTopEdgeShelf, Mode=OneWay}"
                                                            Tag="{x:Bind}"
                                                            Text="Top" />
                                                        <RadioMenuFlyoutItem
                                                            Click="OnMoveToBottomMenuClick"
                                                            GroupName="EdgeShelf"
                                                            IsChecked="{x:Bind IsOnBottomEdgeShelf, Mode=OneWay}"
                                                            Tag="{x:Bind}"
                                                            Text="Bottom" />
                                                    </MenuFlyoutSubItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>

                                            <Border
                                                x:Name="ExpandedSurface"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed" />
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid
                                                    x:Name="StackHeaderSurface"
                                                    PointerEntered="OnVerticalStackHeaderPointerEntered"
                                                    PointerExited="OnVerticalStackHeaderPointerExited">
                                                    <Border
                                                        x:Name="StackHeaderHoverBackground"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        IsHitTestVisible="False"
                                                        Opacity="0" />
                                                    <Button
                                                        x:Name="StackHeaderButton"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        AutomationProperties.HelpText="Expand or collapse this stack to organize its items"
                                                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnVerticalStackHeaderClick"
                                                        DragStarting="OnStackDragStarting"
                                                        Loaded="OnStackDragSurfaceLoaded"
                                                        Tag="{x:Bind}"
                                                        Unloaded="OnStackDragSurfaceUnloaded">
                                                        <Button.Resources />
                                                        <Grid MinHeight="{x:Bind CardLayout.HeaderMinHeight, Mode=OneWay}" Padding="7,5">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid
                                                                Grid.ColumnSpan="{x:Bind CardLayout.PreviewColumnSpan, Mode=OneWay}"
                                                                Width="{x:Bind CardLayout.PreviewContainerWidth, Mode=OneWay}"
                                                                Height="{x:Bind CardLayout.PreviewContainerHeight, Mode=OneWay}"
                                                                Margin="{x:Bind CardLayout.PreviewMargin, Mode=OneWay}"
                                                                HorizontalAlignment="{x:Bind CardLayout.PreviewHorizontalAlignment, Mode=OneWay}">
                                                                <Border
                                                                    Width="{x:Bind CardLayout.ThirdPreviewWidth, Mode=OneWay}"
                                                                    Height="{x:Bind CardLayout.ThirdPreviewHeight, Mode=OneWay}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                    BorderBrush="{x:Bind TintBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{x:Bind CardLayout.BackCornerRadius, Mode=OneWay}"
                                                                    Opacity="0.55"
                                                                    Visibility="{x:Bind ThirdLayerVisibility, Mode=OneWay}">
                                                                    <Border.RenderTransform>
                                                                        <CompositeTransform Rotation="12" TranslateY="{x:Bind CardLayout.ThirdTranslateY, Mode=OneWay}" />
                                                                    </Border.RenderTransform>
                                                                    <Image
                                                                        Source="{x:Bind ThirdPreviewThumbnailSource, Mode=OneWay}"
                                                                        Stretch="UniformToFill"
                                                                        Visibility="{x:Bind ThirdPreviewThumbnailVisibility, Mode=OneWay}" />
                                                                </Border>
                                                                <Border
                                                                    Width="{x:Bind CardLayout.SecondPreviewWidth, Mode=OneWay}"
                                                                    Height="{x:Bind CardLayout.SecondPreviewHeight, Mode=OneWay}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                    BorderBrush="{x:Bind TintBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{x:Bind CardLayout.BackCornerRadius, Mode=OneWay}"
                                                                    Opacity="0.78"
                                                                    Visibility="{x:Bind SecondLayerVisibility, Mode=OneWay}">
                                                                    <Border.RenderTransform>
                                                                        <CompositeTransform Rotation="-9" TranslateY="{x:Bind CardLayout.SecondTranslateY, Mode=OneWay}" />
                                                                    </Border.RenderTransform>
                                                                    <Image
                                                                        Source="{x:Bind SecondPreviewThumbnailSource, Mode=OneWay}"
                                                                        Stretch="UniformToFill"
                                                                        Visibility="{x:Bind SecondPreviewThumbnailVisibility, Mode=OneWay}" />
                                                                </Border>
                                                                <Border
                                                                    Width="{x:Bind CardLayout.FrontPreviewWidth, Mode=OneWay}"
                                                                    Height="{x:Bind CardLayout.FrontPreviewHeight, Mode=OneWay}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                    BorderBrush="{x:Bind TintBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{x:Bind CardLayout.FrontCornerRadius, Mode=OneWay}">
                                                                    <Grid>
                                                                        <Image
                                                                            Source="{x:Bind PreviewThumbnailSource, Mode=OneWay}"
                                                                            Stretch="UniformToFill"
                                                                            Visibility="{x:Bind PreviewThumbnailVisibility, Mode=OneWay}" />
                                                                        <FontIcon
                                                                            FontSize="{x:Bind CardLayout.PreviewGlyphFontSize, Mode=OneWay}"
                                                                            Foreground="{x:Bind TintBrush}"
                                                                            Glyph="{x:Bind LeadingGlyph, Mode=OneWay}"
                                                                            Visibility="{x:Bind PreviewGlyphVisibility, Mode=OneWay}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                            <StackPanel
                                                                Grid.Row="{x:Bind CardLayout.TextRow, Mode=OneWay}"
                                                                Grid.Column="{x:Bind CardLayout.TextColumn, Mode=OneWay}"
                                                                Grid.ColumnSpan="{x:Bind CardLayout.TextColumnSpan, Mode=OneWay}"
                                                                Margin="{x:Bind CardLayout.TextMargin, Mode=OneWay}"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="{x:Bind CardLayout.TextVerticalAlignment, Mode=OneWay}"
                                                                Spacing="1">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    MaxLines="1"
                                                                    Text="{x:Bind Name, Mode=OneWay}"
                                                                    TextAlignment="{x:Bind CardLayout.TextAlignment, Mode=OneWay}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind ItemCountText, Mode=OneWay}"
                                                                    TextAlignment="{x:Bind CardLayout.TextAlignment, Mode=OneWay}" />
                                                            </StackPanel>
                                                            <FontIcon
                                                                x:Name="ExpansionGlyph"
                                                                Grid.RowSpan="2"
                                                                Grid.Column="3"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xE70D;" />
                                                        </Grid>
                                                    </Button>
                                                    <Button
                                                        x:Name="InspectorButton"
                                                        Width="30"
                                                        Height="30"
                                                        Margin="0,0,60,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Inspect stack"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Canvas.ZIndex="2"
                                                        Click="OnInspectStackClick"
                                                        IsHitTestVisible="False"
                                                        IsTabStop="False"
                                                        Opacity="0"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Inspect stack">
                                                        <SymbolIcon Symbol="View" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PopOutButton"
                                                        Width="30"
                                                        Height="30"
                                                        Margin="0,0,30,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Pop out stack as a tray window"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Canvas.ZIndex="2"
                                                        Click="OnOpenTrayMenuClick"
                                                        IsHitTestVisible="False"
                                                        IsTabStop="False"
                                                        Opacity="0"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Pop out as tray">
                                                        <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                                                    </Button>
                                                </Grid>

                                                <controls:StackItemsOrganizer
                                                    x:Name="OrganizerPanel"
                                                    Grid.Row="1"
                                                    Margin="10,0,10,8"
                                                    OwnsScrolling="True"
                                                    Stack="{x:Bind}"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                            <Border
                                                x:Name="StackDropOutline"
                                                BorderBrush="{x:Bind TintBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed" />
                                            <controls:InsertionAdorner x:Name="StackInsertionAdorner" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                x:Name="VerticalEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="This edge shelf has no stacks"
                                Spacing="8">
                                <FontIcon
                                    FontSize="30"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8F1;" />
                                <TextBlock
                                    x:Name="VerticalEmptyStateTitle"
                                    FontWeight="SemiBold"
                                    Text="No stacks on this edge" />
                                <TextBlock
                                    x:Name="VerticalEmptyStateDescription"
                                    MaxWidth="260"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Drop content here or add a stack from OmniTray."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <controls:DropCommandSurface
                            x:Name="VerticalCommandSurface"
                            Grid.Row="2"
                            Margin="10,2,10,2" />

                        <Grid
                            Grid.Row="3"
                            Margin="10,2,10,10"
                            ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="VerticalNewStackButton"
                                Padding="10,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AllowDrop="True"
                                AutomationProperties.HelpText="Click for an empty stack, or drop content to create a stack"
                                AutomationProperties.Name="New stack in edge shelf"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnNewStackClick"
                                DragLeave="OnNewStackDragLeave"
                                DragOver="OnNewStackDragOver"
                                Drop="OnNewStackDrop"
                                ToolTipService.ToolTip="New stack">
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="17"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE710;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="New stack" />
                                </Grid>
                            </Button>
                            <Border
                                x:Name="VerticalNewStackDropOutline"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Button
                                Grid.Column="1"
                                Padding="10,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.HelpText="Create a stack from supported clipboard content"
                                AutomationProperties.Name="Add stack from clipboard"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnAddStackFromClipboardClick"
                                ToolTipService.ToolTip="Add stack from clipboard">
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Symbol="Paste" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="New from clipboard"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid x:Name="HorizontalShelfLayout" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="HorizontalTargetRail" MinHeight="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalPanelCollapsedHeight, Mode=OneWay}">
                            <ScrollViewer
                                x:Name="HorizontalRailScrollViewer"
                                Padding="10,8,108,8"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled"
                                ZoomMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Grid MinWidth="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalCardWidth, Mode=OneWay}" MinHeight="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalCardHeight, Mode=OneWay}">
                                        <ListView
                                            x:Name="HorizontalStackList"
                                            AllowDrop="True"
                                            AutomationProperties.HelpText="Select a stack to organize its items. Drag stacks to reorder them."
                                            AutomationProperties.Name="Stack targets in this edge shelf"
                                            CanDragItems="False"
                                            CanReorderItems="False"
                                            DragLeave="OnStackListDragLeave"
                                            DragOver="OnStackListDragOver"
                                            Drop="OnStackListDrop"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnHorizontalStackItemClick"
                                            ItemContainerStyle="{StaticResource HorizontalStackItemStyle}"
                                            ItemsPanel="{StaticResource HorizontalStackPanel}"
                                            ItemsSource="{x:Bind EdgeStacks, Mode=OneWay}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.HorizontalScrollMode="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollMode="Disabled"
                                            SelectionMode="Single">
                                            <ListView.Resources />
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:DropStackViewModel">
                                                    <Grid
                                                        Width="{x:Bind HorizontalCardLayout.HorizontalCardWidth, Mode=OneWay}"
                                                        Height="{x:Bind HorizontalCardLayout.HorizontalCardHeight, Mode=OneWay}"
                                                        AllowDrop="True"
                                                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                                        DragLeave="OnStackDragLeave"
                                                        DragOver="OnStackDragOver"
                                                        DragStarting="OnStackDragStarting"
                                                        Drop="OnStackDrop"
                                                        Loaded="OnStackDragSurfaceLoaded"
                                                        PointerEntered="OnStackPointerEntered"
                                                        PointerExited="OnStackPointerExited"
                                                        Tag="{x:Bind}"
                                                        Unloaded="OnStackDragSurfaceUnloaded">
                                                        <Grid.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    Click="OnInspectStackClick"
                                                                    Icon="View"
                                                                    Tag="{x:Bind}"
                                                                    Text="Inspect" />
                                                                <MenuFlyoutItem
                                                                    Click="OnOpenTrayMenuClick"
                                                                    Tag="{x:Bind}"
                                                                    Text="Pop out as tray">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE8A7;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem
                                                                    Click="OnInsertClipboardContentMenuClick"
                                                                    Icon="Paste"
                                                                    Tag="{x:Bind}"
                                                                    Text="Insert Clipboard content" />
                                                                <MenuFlyoutSubItem Text="Edge shelf">
                                                                    <RadioMenuFlyoutItem
                                                                        Click="OnRemoveFromEdgeMenuClick"
                                                                        GroupName="EdgeShelf"
                                                                        IsChecked="{x:Bind IsNotOnEdgeShelf, Mode=OneWay}"
                                                                        Tag="{x:Bind}"
                                                                        Text="None" />
                                                                    <MenuFlyoutSeparator />
                                                                    <RadioMenuFlyoutItem
                                                                        Click="OnMoveToLeftMenuClick"
                                                                        GroupName="EdgeShelf"
                                                                        IsChecked="{x:Bind IsOnLeftEdgeShelf, Mode=OneWay}"
                                                                        Tag="{x:Bind}"
                                                                        Text="Left" />
                                                                    <RadioMenuFlyoutItem
                                                                        Click="OnMoveToRightMenuClick"
                                                                        GroupName="EdgeShelf"
                                                                        IsChecked="{x:Bind IsOnRightEdgeShelf, Mode=OneWay}"
                                                                        Tag="{x:Bind}"
                                                                        Text="Right" />
                                                                    <RadioMenuFlyoutItem
                                                                        Click="OnMoveToTopMenuClick"
                                                                        GroupName="EdgeShelf"
                                                                        IsChecked="{x:Bind IsOnTopEdgeShelf, Mode=OneWay}"
                                                                        Tag="{x:Bind}"
                                                                        Text="Top" />
                                                                    <RadioMenuFlyoutItem
                                                                        Click="OnMoveToBottomMenuClick"
                                                                        GroupName="EdgeShelf"
                                                                        IsChecked="{x:Bind IsOnBottomEdgeShelf, Mode=OneWay}"
                                                                        Tag="{x:Bind}"
                                                                        Text="Bottom" />
                                                                </MenuFlyoutSubItem>
                                                            </MenuFlyout>
                                                        </Grid.ContextFlyout>

                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid
                                                                Grid.Row="{x:Bind HorizontalCardLayout.HorizontalPreviewRow, Mode=OneWay}"
                                                                Grid.RowSpan="{x:Bind HorizontalCardLayout.HorizontalPreviewRowSpan, Mode=OneWay}"
                                                                Grid.Column="{x:Bind HorizontalCardLayout.HorizontalPreviewColumn, Mode=OneWay}"
                                                                Grid.ColumnSpan="{x:Bind HorizontalCardLayout.HorizontalPreviewColumnSpan, Mode=OneWay}"
                                                                Width="{x:Bind HorizontalCardLayout.HorizontalPreviewContainerWidth, Mode=OneWay}"
                                                                Height="{x:Bind HorizontalCardLayout.HorizontalPreviewContainerHeight, Mode=OneWay}"
                                                                Margin="{x:Bind HorizontalCardLayout.HorizontalPreviewMargin, Mode=OneWay}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                                <Border
                                                                    Width="{x:Bind HorizontalCardLayout.HorizontalThirdPreviewWidth, Mode=OneWay}"
                                                                    Height="{x:Bind HorizontalCardLayout.HorizontalThirdPreviewHeight, Mode=OneWay}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                    BorderBrush="{x:Bind TintBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="7"
                                                                    Opacity="0.5"
                                                                    Visibility="{x:Bind ThirdLayerVisibility, Mode=OneWay}">
                                                                    <Border.RenderTransform>
                                                                        <CompositeTransform Rotation="12" TranslateY="7" />
                                                                    </Border.RenderTransform>
                                                                    <Image
                                                                        Source="{x:Bind ThirdPreviewThumbnailSource, Mode=OneWay}"
                                                                        Stretch="UniformToFill"
                                                                        Visibility="{x:Bind ThirdPreviewThumbnailVisibility, Mode=OneWay}" />
                                                                </Border>
                                                                <Border
                                                                    Width="{x:Bind HorizontalCardLayout.HorizontalSecondPreviewWidth, Mode=OneWay}"
                                                                    Height="{x:Bind HorizontalCardLayout.HorizontalSecondPreviewHeight, Mode=OneWay}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                    BorderBrush="{x:Bind TintBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="7"
                                                                    Opacity="0.76"
                                                                    Visibility="{x:Bind SecondLayerVisibility, Mode=OneWay}">
                                                                    <Border.RenderTransform>
                                                                        <CompositeTransform Rotation="-9" TranslateY="3" />
                                                                    </Border.RenderTransform>
                                                                    <Image
                                                                        Source="{x:Bind SecondPreviewThumbnailSource, Mode=OneWay}"
                                                                        Stretch="UniformToFill"
                                                                        Visibility="{x:Bind SecondPreviewThumbnailVisibility, Mode=OneWay}" />
                                                                </Border>
                                                                <Border
                                                                    Width="{x:Bind HorizontalCardLayout.HorizontalFrontPreviewWidth, Mode=OneWay}"
                                                                    Height="{x:Bind HorizontalCardLayout.HorizontalFrontPreviewHeight, Mode=OneWay}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                    BorderBrush="{x:Bind TintBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                    <Grid>
                                                                        <Image
                                                                            Source="{x:Bind PreviewThumbnailSource, Mode=OneWay}"
                                                                            Stretch="UniformToFill"
                                                                            Visibility="{x:Bind PreviewThumbnailVisibility, Mode=OneWay}" />
                                                                        <FontIcon
                                                                            FontSize="{x:Bind HorizontalCardLayout.HorizontalPreviewGlyphFontSize, Mode=OneWay}"
                                                                            Foreground="{x:Bind TintBrush}"
                                                                            Glyph="{x:Bind LeadingGlyph, Mode=OneWay}"
                                                                            Visibility="{x:Bind PreviewGlyphVisibility, Mode=OneWay}" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border
                                                                    Height="20"
                                                                    MinWidth="20"
                                                                    Padding="5,0"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="10"
                                                                    Visibility="{x:Bind TileCountBadgeVisibility, Mode=OneWay}">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                        Text="{x:Bind TileCountBadgeText, Mode=OneWay}" />
                                                                </Border>
                                                                <Button
                                                                    x:Name="InspectorButton"
                                                                    Width="25"
                                                                    Height="25"
                                                                    Margin="0,-4,20,0"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    AutomationProperties.Name="Inspect stack"
                                                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                                    BorderThickness="0"
                                                                    Canvas.ZIndex="2"
                                                                    Click="OnInspectStackClick"
                                                                    GotFocus="OnStackActionButtonGotFocus"
                                                                    LostFocus="OnStackActionButtonLostFocus"
                                                                    Opacity="0.16"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="Inspect stack">
                                                                    <SymbolIcon Symbol="View" />
                                                                </Button>
                                                                <Button
                                                                    x:Name="PopOutButton"
                                                                    Width="25"
                                                                    Height="25"
                                                                    Margin="0,-4,-7,0"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    AutomationProperties.Name="Pop out stack as a tray window"
                                                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                                    BorderThickness="0"
                                                                    Canvas.ZIndex="2"
                                                                    Click="OnOpenTrayMenuClick"
                                                                    GotFocus="OnStackActionButtonGotFocus"
                                                                    LostFocus="OnStackActionButtonLostFocus"
                                                                    Opacity="0.16"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="Pop out as tray">
                                                                    <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                                                                </Button>
                                                            </Grid>
                                                            <TextBlock
                                                                Grid.Row="{x:Bind HorizontalCardLayout.HorizontalTextRow, Mode=OneWay}"
                                                                Grid.RowSpan="{x:Bind HorizontalCardLayout.HorizontalTextRowSpan, Mode=OneWay}"
                                                                Grid.Column="{x:Bind HorizontalCardLayout.HorizontalTextColumn, Mode=OneWay}"
                                                                Grid.ColumnSpan="{x:Bind HorizontalCardLayout.HorizontalTextColumnSpan, Mode=OneWay}"
                                                                Width="{x:Bind HorizontalCardLayout.HorizontalNameWidth, Mode=OneWay}"
                                                                Margin="{x:Bind HorizontalCardLayout.HorizontalTextMargin, Mode=OneWay}"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="{x:Bind HorizontalCardLayout.HorizontalTextVerticalAlignment, Mode=OneWay}"
                                                                FontSize="12"
                                                                MaxLines="2"
                                                                Text="{x:Bind Name, Mode=OneWay}"
                                                                TextAlignment="{x:Bind HorizontalCardLayout.HorizontalTextAlignment, Mode=OneWay}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Grid>
                                                        <Border
                                                            x:Name="StackDropOutline"
                                                            BorderBrush="{x:Bind TintBrush}"
                                                            BorderThickness="2"
                                                            CornerRadius="8"
                                                            IsHitTestVisible="False"
                                                            Visibility="Collapsed" />
                                                        <controls:InsertionAdorner x:Name="StackInsertionAdorner" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <TextBlock
                                            x:Name="HorizontalEmptyState"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Drop here to make a stack"
                                            TextAlignment="Center" />
                                    </Grid>

                                    <Button
                                        x:Name="HorizontalNewStackButton"
                                        Width="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalActionWidth, Mode=OneWay}"
                                        Height="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalActionHeight, Mode=OneWay}"
                                        AllowDrop="True"
                                        AutomationProperties.HelpText="Click for an empty stack, or drop content to create a stack"
                                        AutomationProperties.Name="New stack"
                                        Click="OnNewStackClick"
                                        DragLeave="OnNewStackDragLeave"
                                        DragOver="OnNewStackDragOver"
                                        Drop="OnNewStackDrop"
                                        Style="{StaticResource LargeTargetButtonStyle}"
                                        ToolTipService.ToolTip="New stack">
                                        <StackPanel Height="84" Spacing="5">
                                            <Border
                                                Width="52"
                                                Height="46"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <FontIcon
                                                    FontSize="22"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE710;" />
                                            </Border>
                                            <TextBlock
                                                Width="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalActionNameWidth, Mode=OneWay}"
                                                FontSize="12"
                                                Text="New stack"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Width="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalActionWidth, Mode=OneWay}"
                                        Height="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalActionHeight, Mode=OneWay}"
                                        AutomationProperties.HelpText="Create a stack from supported clipboard content"
                                        AutomationProperties.Name="Add stack from clipboard"
                                        Click="OnAddStackFromClipboardClick"
                                        Style="{StaticResource LargeTargetButtonStyle}"
                                        ToolTipService.ToolTip="Add stack from clipboard">
                                        <StackPanel Height="84" Spacing="5">
                                            <Border
                                                Width="52"
                                                Height="46"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <SymbolIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Symbol="Paste" />
                                            </Border>
                                            <TextBlock
                                                Width="{x:Bind ViewModel.HorizontalStackCardLayout.HorizontalActionNameWidth, Mode=OneWay}"
                                                FontSize="12"
                                                Text="From clipboard"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Button>

                                    <Rectangle
                                        Width="1"
                                        Height="76"
                                        Margin="5,0,7,0"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <controls:DropCommandSurface
                                        x:Name="HorizontalCommandSurface"
                                        VerticalAlignment="Center"
                                        IsHorizontal="True" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel
                                Margin="0,2,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Canvas.ZIndex="3"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="HorizontalSearchButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.HelpText="Open a live filter for the stacks on this shelf"
                                    AutomationProperties.Name="Search stacks"
                                    Click="OnSearchClick"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Search stacks (Ctrl+F)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                                    </Button.KeyboardAccelerators>
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE721;" />
                                </Button>
                                <Button
                                    x:Name="HorizontalMoreButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="Shelf options"
                                    Click="OnMoreClick"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Shelf options">
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="Hide edge shelf"
                                    Click="OnCollapseClick"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Hide">
                                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="HorizontalDetailPanel"
                            Grid.Row="1"
                            Padding="14,8,14,10"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Glyph="&#xE8F1;" />
                                        <TextBlock
                                            x:Name="HorizontalDetailTitle"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="HorizontalDetailCount"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <Button
                                        x:Name="HorizontalDetailInspectButton"
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        AutomationProperties.Name="Inspect stack"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnInspectStackClick"
                                        ToolTipService.ToolTip="Inspect stack">
                                        <SymbolIcon Symbol="View" />
                                    </Button>
                                    <Button
                                        x:Name="HorizontalDetailPopOutButton"
                                        Grid.Column="2"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        AutomationProperties.Name="Pop out stack as a tray window"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnOpenTrayMenuClick"
                                        ToolTipService.ToolTip="Pop out as tray">
                                        <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        AutomationProperties.Name="Collapse stack details"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnCloseHorizontalDetailClick"
                                        ToolTipService.ToolTip="Collapse details">
                                        <FontIcon
                                            x:Name="HorizontalDetailCollapseIcon"
                                            FontSize="12"
                                            Glyph="&#xE70D;" />
                                    </Button>
                                </Grid>
                                <controls:StackItemsOrganizer
                                    x:Name="HorizontalOrganizer"
                                    Grid.Row="1"
                                    OwnsScrolling="True" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border
                        x:Name="LeadingScrollZone"
                        AllowDrop="True"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        Canvas.ZIndex="20"
                        CornerRadius="8"
                        DragOver="OnScrollZoneDragOver"
                        Opacity="0.72"
                        Tag="Leading"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="LeadingScrollIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border
                        x:Name="TrailingScrollZone"
                        AllowDrop="True"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        Canvas.ZIndex="20"
                        CornerRadius="8"
                        DragOver="OnScrollZoneDragOver"
                        Opacity="0.72"
                        Tag="Trailing"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="TrailingScrollIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Border
                    x:Name="HintRail"
                    Background="Transparent"
                    Canvas.ZIndex="50"
                    IsHitTestVisible="False">
                    <FontIcon
                        x:Name="HintRailIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE700;" />
                </Border>
            </Grid>
        </Grid>

        <primitives:Popup
            x:Name="StackInspectorPopup"
            Closed="OnStackInspectorPopupClosed"
            IsLightDismissEnabled="True"
            LightDismissOverlayMode="Off"
            Opened="OnStackInspectorPopupOpened"
            ShouldConstrainToRootBounds="False" />
    </Grid>
</views:TransparentWindow>
