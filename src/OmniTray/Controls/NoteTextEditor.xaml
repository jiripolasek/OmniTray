<UserControl
    x:Class="OmniTray.Controls.NoteTextEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid x:Name="RootGrid" GotFocus="OnFocusChanged" LostFocus="OnFocusChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <RichEditBox x:Name="TextBox" Margin="8,0,8,8" Padding="12"
                     AutomationProperties.Name="Note text" BorderThickness="0" Background="Transparent"
                     FontSize="16" IsSpellCheckEnabled="True" TextWrapping="Wrap"
                     AcceptsReturn="True" TextChanged="OnTextChanged" SelectionChanged="OnSelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <CommandBar x:Name="FormattingBar" Grid.Row="1" Background="Transparent" Visibility="Collapsed"
                    AutomationProperties.Name="Text formatting" DefaultLabelPosition="Collapsed"
                    OverflowButtonVisibility="Auto" IsDynamicOverflowEnabled="True" IsOpen="False"
                    Opened="OnFormattingBarOpenChanged" Closed="OnFormattingBarOpenChanged">
            <AppBarToggleButton x:Name="BoldButton" Icon="Bold" Label="Bold"
                                Click="OnBoldClick" ToolTipService.ToolTip="Bold (Ctrl+B)" />
            <AppBarToggleButton x:Name="ItalicButton" Icon="Italic" Label="Italic"
                                Click="OnItalicClick" ToolTipService.ToolTip="Italic (Ctrl+I)" />
            <AppBarToggleButton x:Name="UnderlineButton" Icon="Underline" Label="Underline"
                                Click="OnUnderlineClick" ToolTipService.ToolTip="Underline (Ctrl+U)" />
            <AppBarToggleButton x:Name="BulletsButton" Icon="Bullets" Label="Bullets" Click="OnBulletsClick" />
        </CommandBar>
    </Grid>
</UserControl>