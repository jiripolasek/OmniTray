<UserControl
    x:Class="OmniTray.Controls.NoteEditorPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniTray.Controls"
    IsTabStop="False">
    <Grid x:Name="RootGrid" CornerRadius="8" ActualThemeChanged="OnThemeChanged">
        <Grid.Resources>
            <Style x:Key="NotePaneButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="12,6,4,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Note" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DetailsButton" Style="{StaticResource NotePaneButtonStyle}" AutomationProperties.Name="Note details">
                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="8" MaxWidth="260">
                                <TextBlock x:Name="UpdatedText" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="CreatedText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SaveStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ColorButton" Style="{StaticResource NotePaneButtonStyle}"
                        AutomationProperties.Name="Note color" ToolTipService.ToolTip="Note color">
                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Opening="OnColorMenuOpening" />
                    </Button.Flyout>
                </Button>
                <Button Style="{StaticResource NotePaneButtonStyle}" Click="OnOpenWindowClick"
                        AutomationProperties.Name="Open note in window" ToolTipService.ToolTip="Open in window">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
        <controls:NoteTextEditor x:Name="Editor" Grid.Row="1" TextChanged="OnTextChanged" />
        <InfoBar x:Name="FormatErrorBar" Grid.Row="2" IsOpen="False" Severity="Warning" IsClosable="True"
                 Title="Could not open formatting"
                 Message="Plain text is available. The original formatting is kept until you edit." />
    </Grid>
</UserControl>
