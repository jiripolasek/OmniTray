<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="OmniTray.Controls.StackColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="310" Spacing="8">
        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Tray color" />

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="NeutralButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.HelpText="Use a subtle Fluent neutral color that follows the app's light or dark theme"
                AutomationProperties.Name="Use neutral theme color"
                Click="OnNeutralClick"
                ToolTipService.ToolTip="Subtle neutral, follows theme">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="NeutralSwatch"
                        Width="24"
                        Height="24"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Border
                            x:Name="NeutralSelection"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="Collapsed">
                            <FontIcon
                                FontSize="10"
                                Foreground="Black"
                                Glyph="&#xE73E;" />
                        </Border>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Text="Neutral" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton
                x:Name="SystemAccentButton"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.HelpText="Follow the accent color selected in Windows Settings"
                AutomationProperties.Name="Use system accent color"
                Click="OnSystemAccentClick"
                ToolTipService.ToolTip="Follow Windows accent color">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="SystemAccentSwatch"
                        Width="24"
                        Height="24"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Border
                            x:Name="SystemAccentSelection"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="Collapsed">
                            <FontIcon
                                FontSize="10"
                                Foreground="Black"
                                Glyph="&#xE73E;" />
                        </Border>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Text="Accent" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <TextBlock
            Margin="2,2,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="Windows colors" />

        <Grid
            x:Name="PaletteGrid"
            ColumnSpacing="2"
            RowSpacing="2" />
    </StackPanel>
</UserControl>
