<UserControl
    x:Class="OmniTray.Controls.StackColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MinWidth="310" Spacing="8">
        <TextBlock Text="Tray color" />

        <TextBlock
            Margin="2,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="Colors" />

        <Grid
            x:Name="PaletteGrid"
            ColumnSpacing="2"
            RowSpacing="2">
            <Button
                x:Name="NeutralButton"
                Width="30"
                Height="30"
                Padding="1"
                HorizontalAlignment="Center"
                AutomationProperties.HelpText="Use the global Neutral tray color configured in Settings"
                AutomationProperties.Name="Neutral tray color"
                Background="Transparent"
                BorderThickness="0"
                Click="OnNeutralClick"
                CornerRadius="6"
                ToolTipService.ToolTip="Neutral">
                <Grid Width="28" Height="28">
                    <Border
                        x:Name="NeutralSwatch"
                        Background="{ThemeResource TextFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <Border
                        x:Name="NeutralSelection"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="10"
                            Foreground="Black"
                            Glyph="&#xE73E;" />
                    </Border>
                </Grid>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>