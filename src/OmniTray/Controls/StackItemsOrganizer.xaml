<UserControl
    x:Class="OmniTray.Controls.StackItemsOrganizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniTray.Controls"
    xmlns:viewModels="using:OmniTray.ViewModels">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="ListItemsPanel">
            <ItemsStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ThumbnailItemsPanel">
            <ItemsWrapGrid
                HorizontalAlignment="Stretch"
                ItemHeight="120"
                ItemWidth="108"
                Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style x:Key="ListItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="ThumbnailItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <DataTemplate x:Key="SmallListItemTemplate" x:DataType="viewModels:DropItemViewModel">
            <Grid
                MinHeight="48"
                Padding="32,8,8,8"
                AllowDrop="True"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                ColumnSpacing="9"
                ContextRequested="OnItemRowContextRequested"
                PointerEntered="OnItemRowPointerEntered"
                PointerExited="OnItemRowPointerExited"
                Tag="{x:Bind}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="38" Height="38">
                    <Border
                        Visibility="{x:Bind NonNoteVisibility}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{x:Bind ThumbnailBorderThickness, Mode=OneWay}"
                        CornerRadius="6">
                        <controls:ThumbnailImagePresenter
                            HasVideoFilmstrip="{x:Bind ThumbnailHasVideoFilmstrip, Mode=OneWay}"
                            IsShellIcon="{x:Bind ThumbnailIsShellIcon, Mode=OneWay}"
                            ShellIconSize="32"
                            Source="{x:Bind ThumbnailSource, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                    </Border>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="17"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind LeadingGlyph, Mode=OneWay}"
                        Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                    <controls:NotePreview Note="{x:Bind Model.Note, Mode=OneWay}" Compact="True" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        MaxLines="1"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind KindLabel, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Model.Note.Text, Mode=OneWay}" Visibility="{x:Bind NoteVisibility}" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
                <controls:NoteIndicator Grid.Column="2" Item="{x:Bind}" VerticalAlignment="Center" />
                <controls:InsertionAdorner x:Name="ItemInsertionAdorner" Grid.ColumnSpan="3" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LargeListItemTemplate" x:DataType="viewModels:DropItemViewModel">
            <Grid
                MinHeight="80"
                Padding="32,8,8,8"
                AllowDrop="True"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                ColumnSpacing="12"
                ContextRequested="OnItemRowContextRequested"
                PointerEntered="OnItemRowPointerEntered"
                PointerExited="OnItemRowPointerExited"
                Tag="{x:Bind}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="64" Height="64">
                    <Border
                        Visibility="{x:Bind NonNoteVisibility}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{x:Bind ThumbnailBorderThickness, Mode=OneWay}"
                        CornerRadius="8">
                        <controls:ThumbnailImagePresenter
                            HasVideoFilmstrip="{x:Bind ThumbnailHasVideoFilmstrip, Mode=OneWay}"
                            IsShellIcon="{x:Bind ThumbnailIsShellIcon, Mode=OneWay}"
                            ShellIconSize="64"
                            Source="{x:Bind ThumbnailSource, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                    </Border>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind LeadingGlyph, Mode=OneWay}"
                        Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                    <controls:NotePreview Note="{x:Bind Model.Note, Mode=OneWay}" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        MaxLines="1"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind KindLabel, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Model.Note.Text, Mode=OneWay}" Visibility="{x:Bind NoteVisibility}" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
                <controls:NoteIndicator Grid.Column="2" Item="{x:Bind}" VerticalAlignment="Center" />
                <controls:InsertionAdorner x:Name="ItemInsertionAdorner" Grid.ColumnSpan="3" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ThumbnailItemTemplate" x:DataType="viewModels:DropItemViewModel">
            <Grid
                Padding="4"
                AllowDrop="True"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                ContextRequested="OnItemRowContextRequested"
                PointerEntered="OnItemRowPointerEntered"
                PointerExited="OnItemRowPointerExited"
                Tag="{x:Bind}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="2">
                    <Border
                        Visibility="{x:Bind NonNoteVisibility}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{x:Bind ThumbnailBorderThickness, Mode=OneWay}"
                        CornerRadius="7">
                        <controls:ThumbnailImagePresenter
                            HasVideoFilmstrip="{x:Bind ThumbnailHasVideoFilmstrip, Mode=OneWay}"
                            IsShellIcon="{x:Bind ThumbnailIsShellIcon, Mode=OneWay}"
                            ShellIconSize="64"
                            Source="{x:Bind ThumbnailSource, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                    </Border>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind LeadingGlyph, Mode=OneWay}"
                        Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                    <controls:NotePreview Note="{x:Bind Model.Note, Mode=OneWay}" />
                    <controls:NoteIndicator Item="{x:Bind}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="3,3,3,0"
                    HorizontalAlignment="Stretch"
                    MaxLines="1"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind DisplayName, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <controls:InsertionAdorner x:Name="ItemInsertionAdorner" Grid.RowSpan="2" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ItemsHostRow" Height="Auto" />
        </Grid.RowDefinitions>
        <ListView
            x:Name="ItemList"
            AllowDrop="True"
            AutomationProperties.HelpText="Hover with a mouse, or use the context menu, to show commands. Drag to reorder or move; hold Control while dragging to copy."
            AutomationProperties.Name="Items in expanded stack"
            Background="Transparent"
            CanDragItems="True"
            CanReorderItems="False"
            DragItemsCompleted="OnItemDragItemsCompleted"
            DragItemsStarting="OnItemDragItemsStarting"
            DragLeave="OnItemListDragLeave"
            DragOver="OnItemListDragOver"
            Drop="OnItemListDrop"
            DoubleTapped="OnItemListDoubleTapped"
            ItemContainerStyle="{StaticResource ListItemContainerStyle}"
            ItemTemplate="{StaticResource SmallListItemTemplate}"
            ItemsPanel="{StaticResource ListItemsPanel}"
            KeyDown="OnItemListKeyDown"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionChanged="OnItemSelectionChanged"
            SelectionMode="Extended"
            SizeChanged="OnItemListSizeChanged">
            <ListView.ContextFlyout>
                <CommandBarFlyout
                    x:Name="SelectionCommandsFlyout"
                    AutomationProperties.Name="Selected item commands"
                    Opening="OnSelectionCommandsFlyoutOpening"
                    Closed="OnSelectionCommandsFlyoutClosed">
                    <CommandBarFlyout.PrimaryCommands>
                        <AppBarButton
                            x:Name="OpenSelectionButton"
                            AutomationProperties.Name="Open selected item"
                            Click="OnOpenSelectionClick"
                            Label="Open"
                            ToolTipService.ToolTip="Open"
                            Visibility="Collapsed">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="MoveSelectionUpButton"
                            AutomationProperties.Name="Move selected items up"
                            Click="OnMoveSelectionUpClick"
                            Label="Move up"
                            ToolTipService.ToolTip="Move up">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE70E;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="MoveSelectionDownButton"
                            AutomationProperties.Name="Move selected items down"
                            Click="OnMoveSelectionDownClick"
                            Label="Move down"
                            ToolTipService.ToolTip="Move down">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE70D;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="SplitSelectionButton"
                            AutomationProperties.Name="Split selected items into a new stack"
                            Click="OnSplitSelectionClick"
                            Label="Split"
                            ToolTipService.ToolTip="Split into a new stack">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C6;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="RemoveSelectionButton"
                            AutomationProperties.Name="Remove selected items"
                            Click="OnRemoveSelectionClick"
                            Icon="Remove"
                            Label="Remove"
                            ToolTipService.ToolTip="Remove from stack" />
                    </CommandBarFlyout.PrimaryCommands>
                    <CommandBarFlyout.SecondaryCommands>
                        <AppBarButton
                            x:Name="ConvertToNoteButton"
                            AutomationProperties.Name="Convert text item to an editable note"
                            Click="OnConvertToNoteClick"
                            Label="Convert to note"
                            Visibility="Collapsed">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE70B;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="DuplicateAsNoteButton"
                            AutomationProperties.Name="Duplicate text item as an editable note"
                            Click="OnDuplicateAsNoteClick"
                            Icon="Copy"
                            Label="Duplicate as note"
                            Visibility="Collapsed" />
                        <AppBarButton x:Name="ItemNotesButton" Label="Notes" Visibility="Collapsed"
                                      AutomationProperties.Name="Attached notes">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE70B;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout x:Name="ItemNotesMenu" />
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="OpenContainingFolderButton"
                            AutomationProperties.Name="Open containing folder"
                            Click="OnOpenContainingFolderClick"
                            Label="Open containing folder"
                            Visibility="Collapsed">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE838;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="OpenSourceUrlButton"
                            AutomationProperties.Name="Open content source"
                            Click="OnOpenSourceUrlClick"
                            Label="Open source"
                            Visibility="Collapsed">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE71B;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="CopySelectionButton"
                            AutomationProperties.Name="Copy selected items to the clipboard"
                            Click="OnCopySelectionClick"
                            Icon="Copy"
                            Label="Copy" />
                        <AppBarButton
                            x:Name="CutSelectionButton"
                            AutomationProperties.Name="Cut selected filesystem items to the clipboard"
                            Click="OnCutSelectionClick"
                            Icon="Cut"
                            Label="Cut"
                            Visibility="Collapsed" />
                        <AppBarButton
                            x:Name="ShowPropertiesButton"
                            AutomationProperties.Name="Show selected item properties"
                            Click="OnShowPropertiesClick"
                            Icon="Setting"
                            Label="Properties"
                            Visibility="Collapsed" />
                        <AppBarButton
                            x:Name="InspectPayloadButton"
                            AutomationProperties.Name="Inspect captured payload"
                            Click="OnInspectPayloadClick"
                            Label="Inspect payload"
                            Visibility="Collapsed">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="DeleteFromDiskButton"
                            AutomationProperties.Name="Delete selected filesystem items from disk"
                            Click="OnDeleteFromDiskClick"
                            Icon="Delete"
                            Label="Delete from disk"
                            Visibility="Collapsed" />
                        <AppBarButton
                            x:Name="DuplicateSelectionButton"
                            AutomationProperties.Name="Duplicate selected items"
                            Click="OnDuplicateSelectionClick"
                            Icon="Copy"
                            Label="Duplicate" />
                    </CommandBarFlyout.SecondaryCommands>
                </CommandBarFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <TextBlock
            x:Name="EmptyMessage"
            Margin="0,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsHitTestVisible="False"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="This stack is empty. Drop items here or paste from the toolbar."
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

    </Grid>
</UserControl>
