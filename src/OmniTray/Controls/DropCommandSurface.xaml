<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="OmniTray.Controls.DropCommandSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:OmniTray.ViewModels"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Margin="4,2,4,4" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Width="28"
                Height="28"
                Padding="0"
                AutomationProperties.Name="Back to parent command folder"
                Background="Transparent"
                BorderThickness="0"
                Click="OnBackClick"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="HeaderText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Commands" />
        </Grid>

        <ListView
            x:Name="VerticalItems"
            Grid.Row="1"
            MaxHeight="220"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind Items, Mode=OneWay}"
            SelectionMode="None"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:DropCommandPlacementViewModel">
                    <Grid
                        MinHeight="50"
                        HorizontalAlignment="Stretch"
                        AllowDrop="True"
                        DragLeave="OnNodeDragLeave"
                        DragOver="OnNodeDragOver"
                        Drop="OnNodeDrop"
                        Tag="{x:Bind}">
                        <Button
                            Padding="8,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.HelpText="{x:Bind Summary}"
                            AutomationProperties.Name="{x:Bind DisplayName}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnNodeClick"
                            CornerRadius="6"
                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                            Tag="{x:Bind}">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="36"
                                    Height="36"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="7">
                                    <FontIcon FontSize="17" Glyph="{x:Bind Glyph}" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        Text="{x:Bind DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Glyph="&#xE76C;"
                                    Visibility="{x:Bind FolderVisibility}" />
                            </Grid>
                        </Button>
                        <Button
                            Grid.Column="3"
                            Width="28"
                            Height="28"
                            Margin="0,0,5,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Pop out drop command"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPopOutClick"
                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="Pop out command"
                            Visibility="{x:Bind CommandVisibility}">
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </Button>
                        <Border
                            x:Name="DropOutline"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="7"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="HorizontalLayout"
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="2"
            Visibility="Collapsed">
            <Grid
                x:Name="HorizontalBackTarget"
                Width="84"
                Height="104"
                AllowDrop="True"
                DragEnter="OnBackDragEnter"
                DragLeave="OnBackDragLeave"
                DragOver="OnBackDragOver"
                Drop="OnBackDrop"
                Visibility="Collapsed">
                <Button
                    x:Name="HorizontalBackButton"
                    Width="84"
                    Height="104"
                    Padding="4"
                    AutomationProperties.Name="Back to parent command folder"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBackClick"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Back to parent command folder">
                    <StackPanel Spacing="5">
                        <Border
                            Width="52"
                            Height="46"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="21" Glyph="&#xE72B;" />
                        </Border>
                        <TextBlock
                            Width="76"
                            FontSize="12"
                            MaxLines="2"
                            Text="Back"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
                <Border
                    x:Name="HorizontalBackDropOutline"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>

            <ItemsControl
                x:Name="HorizontalItems"
                ItemsSource="{x:Bind Items, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DropCommandPlacementViewModel">
                        <Grid
                            Width="84"
                            Height="104"
                            AllowDrop="True"
                            DragLeave="OnNodeDragLeave"
                            DragOver="OnNodeDragOver"
                            Drop="OnNodeDrop"
                            Tag="{x:Bind}">
                            <Button
                                Width="84"
                                Height="104"
                                Padding="4"
                                AutomationProperties.HelpText="{x:Bind Summary}"
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnNodeClick"
                                CornerRadius="8"
                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                Tag="{x:Bind}">
                                <StackPanel Spacing="5">
                                    <Grid Width="52" Height="46">
                                        <Border
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <FontIcon FontSize="21" Glyph="{x:Bind Glyph}" />
                                        </Border>
                                        <FontIcon
                                            Margin="0,0,4,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="9"
                                            Glyph="&#xE76C;"
                                            Visibility="{x:Bind FolderVisibility}" />
                                    </Grid>
                                    <TextBlock
                                        Width="76"
                                        FontSize="12"
                                        MaxLines="2"
                                        Text="{x:Bind DisplayName}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Button>
                            <Button
                                Width="24"
                                Height="24"
                                Margin="0,1,1,0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Pop out drop command"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderThickness="0"
                                Click="OnPopOutClick"
                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                Opacity="0.45"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Pop out command"
                                Visibility="{x:Bind CommandVisibility}">
                                <FontIcon FontSize="10" Glyph="&#xE8A7;" />
                            </Button>
                            <Border
                                x:Name="DropOutline"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
