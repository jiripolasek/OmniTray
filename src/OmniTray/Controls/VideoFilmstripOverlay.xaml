<UserControl
    x:Class="OmniTray.Controls.VideoFilmstripOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Grid>
        <Viewbox Stretch="Fill">
            <Canvas Width="100" Height="70">
                <Rectangle Width="2" Height="70" Canvas.Left="0" Canvas.Top="0" Fill="#D8000000" />
                <Rectangle Width="2" Height="70" Canvas.Left="9" Canvas.Top="0" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="0" Canvas.Top="0" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="0" Canvas.Top="13" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="0" Canvas.Top="26" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="0" Canvas.Top="39" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="0" Canvas.Top="52" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="0" Canvas.Top="65" Fill="#D8000000" />
                <Rectangle Width="2" Height="70" Canvas.Left="89" Canvas.Top="0" Fill="#D8000000" />
                <Rectangle Width="2" Height="70" Canvas.Left="98" Canvas.Top="0" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="89" Canvas.Top="0" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="89" Canvas.Top="13" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="89" Canvas.Top="26" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="89" Canvas.Top="39" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="89" Canvas.Top="52" Fill="#D8000000" />
                <Rectangle Width="11" Height="5" Canvas.Left="89" Canvas.Top="65" Fill="#D8000000" />
            </Canvas>
        </Viewbox>
        <Border
            Height="2"
            VerticalAlignment="Top"
            Background="#78000000" />
        <Border
            Height="2"
            VerticalAlignment="Bottom"
            Background="#78000000" />
    </Grid>
</UserControl>